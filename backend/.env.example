
# Local PostgreSQL connection
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/bookleaf

# Generate a unique secret for your own environment
JWT_SECRET_KEY=replace_with_a_long_random_secret
ENVIRONMENT=development

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Frontend origin
FRONTEND_URL=http://localhost:5173

# Demo accounts created by python seed.py
ADMIN_EMAIL=admin@bookleaf.com
ADMIN_PASSWORD=change_this_admin_password
DEMO_PASSWORD=change_this_demo_password

# Sample data configuration
SAMPLE_DATA_PATH=data/bookleaf_sample_data.json
SEED_SAMPLE_DATA=false
