# Local PostgreSQL connection.
# Replace YOUR_POSTGRES_PASSWORD with your local PostgreSQL password.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/bookleaf

# Replace this with a long, unique random secret for your local environment.
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=720

# Optional Gemini integration. Leave GEMINI_API_KEY blank to disable AI features.
GEMINI_API_KEY=
# Use a model ID supported by your Gemini API key.
GEMINI_MODEL=gemini-3.8-flash

# Local frontend origin. For a hosted deployment, use your deployed frontend origin.
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development

# Local demo account configuration.
ADMIN_EMAIL=admin@bookleaf.com
ADMIN_PASSWORD=change_this_admin_password
DEMO_PASSWORD=change_this_demo_password

# Optional sample-data settings.
SAMPLE_DATA_PATH=
SEED_SAMPLE_DATA=false
